# TrustLens Environment Variables
# Copy to .env and fill in values. NEVER commit .env

# Database
DATABASE_URL=postgresql+asyncpg://trustlens:trustlens@localhost:5432/trustlens

# OpenRouter (backend only — never expose to frontend)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash-preview-05-20

# Threat Intelligence Providers (backend only)
GOOGLE_SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=

# Application
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-a-random-secret
CORS_ORIGINS=http://localhost:5173

# Rate Limits
RATE_LIMIT_PER_MINUTE=30
SCAN_CONCURRENCY_LIMIT=5

# Evidence Storage
EVIDENCE_STORAGE_PATH=./evidence_store
EVIDENCE_RETENTION_DAYS=90

# Safety
MAX_REDIRECT_HOPS=10
HTTP_TIMEOUT_SECONDS=15
MAX_RESPONSE_BYTES=5242880
SAFE_SCAN_ENABLED=false

