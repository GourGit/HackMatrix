# TrustLens Environment Variables
# Copy to .env and fill in values. NEVER commit .env to version control.

# Database
# In development: postgresql+asyncpg://<user>:<password>@localhost:5432/<database>
# In production: must use strong credentials (default/example passwords will fail startup validation)
DATABASE_URL=postgresql+asyncpg://trustlens:replace-with-secure-password@localhost:5432/trustlens

# Shared State & Rate Limiting (Redis required in production; in-memory fallback in dev/test)
REDIS_URL=redis://localhost:6379/0

# Authentication & Application Secrets (must be >= 32 random characters in production)
APP_SECRET_KEY=replace-with-a-random-secret-key-at-least-32-chars
JWT_SECRET_KEY=replace-with-a-random-jwt-secret-at-least-32-chars

# Application Environment
APP_ENV=development
APP_DEBUG=true

# CORS Allowlist (comma-separated; wildcard '*' is strictly forbidden in production)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# OpenRouter / LLM Providers (backend only — never expose to frontend)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash-preview-05-20

# Threat Intelligence Providers (backend only)
GOOGLE_SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=

# Rate Limits
RATE_LIMIT_PER_MINUTE=30
SCAN_CONCURRENCY_LIMIT=5

# Evidence Storage
EVIDENCE_STORAGE_PATH=./evidence_store
EVIDENCE_RETENTION_DAYS=90

# Safety Guardrails
MAX_REDIRECT_HOPS=10
HTTP_TIMEOUT_SECONDS=15
MAX_RESPONSE_BYTES=5242880
SAFE_SCAN_ENABLED=false
